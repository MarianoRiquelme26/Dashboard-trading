# Variables de entorno - ScalpingFilter

# Token del Bot de Telegram (obtenelo desde @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ID del chat donde el bot enviará alertas (puede ser un grupo o usuario)
TELEGRAM_CHAT_ID=your_chat_id_here

# Puerto del servidor Express (por defecto 3000)
PORT=3000
